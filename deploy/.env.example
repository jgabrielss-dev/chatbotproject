# Gemini (chave usada por TODOS os agentes)
GEMINI_API_KEY=
# Modelo principal + fallbacks (separados por virgula) para tolerar 503/descontinuacao
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_FALLBACKS=gemini-flash-lite-latest,gemini-3.1-flash-lite,gemini-flash-latest,gemini-3.6-flash

# Postgres do Supabase (projeto novo, vinculado ao repo GitHub)
# Use o pooler do Supabase em modo session (porta 5432) pois o Render nao tem IPv6.
# Formato: postgresql://postgres.<ref>:<senha>@aws-0-<regiao>.pooler.supabase.com:5432/postgres
DATABASE_URL=postgresql://postgres.XXXX:senha@aws-0-XXXX.pooler.supabase.com:5432/postgres

# URL pública do app (usada para os webhooks do Telegram e da Evolution)
# Ex.: https://seu-app.onrender.com
BASE_URL=

# Token de acesso do painel. OPCIONAL: vazio = painel aberto, sem login (é o
# padrão). Se você preencher, todas as rotas /api/* passam a exigir o header
# X-Admin-Token e o painel pede o token uma vez (não é login de usuário).
# Gere com: python -c "import secrets;print(secrets.token_urlsafe(24))"
# Mesmo com o painel aberto, os segredos dos canais (token do bot, sessionid,
# access_token, app_secret) NUNCA voltam para o navegador.
ADMIN_TOKEN=

# Fila de mensagens: backoff de quem falhou (sempre volta para o fim da fila,
# nunca e descartado) e quantas mensagens o worker trata por vez.
INBOX_BACKOFF_BASE_SEG=20
INBOX_BACKOFF_TETO_SEG=300
INBOX_LOTE=8

# Base das Edge Functions do Supabase (fila sempre ativa que recebe os
# webhooks mesmo com o Render dormindo). Se vazio, é derivado do DATABASE_URL.
# Ex.: https://SEU-PROJETO.supabase.co/functions/v1/inbox
SUPABASE_FUNCTIONS_BASE=

# Nome da instância Evolution prefixada p/ evitar conflito (opcional)
EVOLUTION_INSTANCE_PREFIX=ag

# Servidor Evolution usado pela plataforma (uma vez, centralizado; os clientes não veem isso)
EVOLUTION_API_URL=
EVOLUTION_API_KEY=

# Intervalo do keepalive da Evolution, em segundos. SÓ afeta o canal WhatsApp
# NÃO-oficial (Evolution/Baileys). O Render hiberna ~15 min sem tráfego:
#   - acima de 900s: o serviço dorme entre os pings (poucas horas por mês)
#   - abaixo de 900s: nunca hiberna -> ~720h/mês das 750h do plano grátis
# Os canais OFICIAIS (whatsapp_oficial / instagram_oficial) NÃO usam keepalive:
# o Meta chama o webhook e o Render só acorda quando chega mensagem.
EVOLUTION_KEEPALIVE_SEG=1800