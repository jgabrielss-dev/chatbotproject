# Gemini (chave usada por TODOS os agentes)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# Postgres do Supabase (projeto novo, vinculado ao repo GitHub)
# Use o pooler do Supabase (porta 6543) pois o Render não tem IPv6.
# Formato: postgresql://postgres.<ref>.supabase:<senha>@aws-0-<regiao>.pooler.supabase.com:6543/postgres
DATABASE_URL=postgresql://postgres.XXXX.supabase:senha@aws-0-XXXX.pooler.supabase.com:6543/postgres

# URL pública do app (usada para os webhooks do Telegram e da Evolution)
# Ex.: https://seu-app.onrender.com
BASE_URL=

# Nome da instância Evolution prefixada p/ evitar conflito (opcional)
EVOLUTION_INSTANCE_PREFIX=ag