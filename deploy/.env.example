# Gemini (chave usada por TODOS os agentes)
GEMINI_API_KEY=
# Modelo principal + fallbacks (separados por virgula) para tolerar 503/descontinuacao
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_FALLBACKS=gemini-flash-lite-latest,gemini-3.1-flash-lite,gemini-flash-latest,gemini-3.6-flash

# Postgres do Supabase (projeto novo, vinculado ao repo GitHub)
# Use o pooler do Supabase em modo session (porta 5432) pois o Render nao tem IPv6.
# Formato: postgresql://postgres.<ref>:<senha>@aws-0-<regiao>.pooler.supabase.com:5432/postgres
DATABASE_URL=postgresql://postgres.XXXX:senha@aws-0-XXXX.pooler.supabase.com:5432/postgres

# URL pública do app (usada para os webhooks do Telegram e da Evolution)
# Ex.: https://seu-app.onrender.com
BASE_URL=

# ==========================================================================
# Contas (Supabase Auth) — OBRIGATÓRIO para o painel funcionar
# ==========================================================================
# Sem estas duas, a API responde 503 em tudo menos /health e as três telas não
# abrem. A API valida o JWT do navegador chamando GET {SUPABASE_URL}/auth/v1/user.
#
# SUPABASE_URL: o mesmo do Functions Base, ex.: https://SEU-PROJETO.supabase.co
SUPABASE_URL=
# A "anon"/"publishable key". É pública por definição (o navegador precisa
# dela para falar com o GoTrue) — a segurança NÃO depende de escondê-la. O que
# protege os dados é a RLS do Postgres e o fato de o service_role nunca vir
# para cá. Nunca use a service_role aqui.
SUPABASE_ANON_KEY=

# Papéis admin. CADASTRO é aberto: qualquer um cria a conta, e o primeiro login
# cai como 'usuario'. Para tornar alguém admin, defina o e-mail aqui E registre
# no banco (a lista em app_config é o que o trigger de cadastro lê):
#
#   INSERT INTO app_config (chave, valor)
#   VALUES ('admin_emails', 'voce@empresa.com')
#   ON CONFLICT (chave) DO UPDATE SET valor = EXCLUDED.valor;
#
# Para promover um admin já cadastrado (sem esperar novo cadastro):
#   UPDATE perfis SET role = 'admin' WHERE email = 'voce@empresa.com';

# Canais NÃO-oficiais (whatsapp via Evolution e instagram via instagrapi)
# para usuário comum. 1 = libera, 0/vazio = só admin (padrão). Estes dois
# dependem de infraestrutura da plataforma e de conta do Instagram do cliente,
# então o padrão é deixar restrito ao admin.
CANAIS_NAO_OFICIAIS_PARA_USUARIOS=0

# Token de recuperação de senha do ADMIN. USE APENAS se o Supabase Auth
# ficar indisponível e você precisar entrar: o painel aceita X-Admin-Token e
# trata a sessão como admin. NÃO é o login normal — o login é a conta Supabase.
# Gere com: python -c "import secrets;print(secrets.token_urlsafe(24))"
# Deixe vazio no dia a dia.
ADMIN_TOKEN=

# Fila de mensagens: backoff de quem falhou (sempre volta para o fim da fila,
# nunca e descartado) e quantas mensagens o worker trata por vez.
INBOX_BACKOFF_BASE_SEG=20
INBOX_BACKOFF_TETO_SEG=300
INBOX_LOTE=8

# Base das Edge Functions do Supabase (fila sempre ativa que recebe os
# webhooks mesmo com o Render dormindo). Se vazio, é derivado do DATABASE_URL.
# Ex.: https://SEU-PROJETO.supabase.co/functions/v1/inbox
SUPABASE_FUNCTIONS_BASE=

# Nome da instância Evolution prefixada p/ evitar conflito (opcional)
EVOLUTION_INSTANCE_PREFIX=ag

# ==========================================================================
# Mercado Pago (cobrança real por PIX)
# ==========================================================================
# PAT = access token da conta (autoriza criar o PIX; é o que LIGA o checkout).
# PK = public key (identifica a conta; exibida no checkout do MP).
# Sem PAT as rotas de checkout respondem 503 e nenhum pagamento é cobrado.
# Gere as duas no painel do Mercado Pago (Desenvolvedores > Credenciais).
MERCADOPAGO_PAT=
MERCADOPAGO_PK=
# Segredo de assinatura do webhook (opcional): configurar no painel do MP em
# "Webhooks". Sem ele a segurança continua de pé — quem confirma é a consulta
# reversa na API do MP; com ele, notificação sem assinatura é cortada antes.
MERCADOPAGO_WEBHOOK_SECRET=
# E-mails que NUNCA precisam pagar (dono/operador da plataforma e contas de
# teste): recebem o plano máximo sem passar pelo checkout. Vírgulas separam.
CONTAS_ISENTAS=voce@empresa.com

# Servidor Evolution usado pela plataforma (uma vez, centralizado; os clientes não veem isso)
EVOLUTION_API_URL=
EVOLUTION_API_KEY=

# Intervalo do keepalive da Evolution, em segundos. SÓ afeta o canal WhatsApp
# NÃO-oficial (Evolution/Baileys). O Render hiberna ~15 min sem tráfego:
#   - acima de 900s: o serviço dorme entre os pings (poucas horas por mês)
#   - abaixo de 900s: nunca hiberna -> ~720h/mês das 750h do plano grátis
# Os canais OFICIAIS (whatsapp_oficial / instagram_oficial) NÃO usam keepalive:
# o Meta chama o webhook e o Render só acorda quando chega mensagem.
EVOLUTION_KEEPALIVE_SEG=1800